# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# macOS
.DS_Store

# Local uploads / flight logs
uploads/*
!uploads/.gitkeep

# Local converter build. Do not commit Betaflight blackbox-tools into AeroTune.
tools/blackbox-tools/

# Local backup files
*.bak
*.bak_*
backups/
static/index_original.html

# Local patch/install artifacts
apply_aerotune_*.py
aerotune_*_patch*.zip
aerotune_*_fix*.zip
AEROTUNE_*_README.md

# Local tune-change reports. Keep generated flight-analysis reports out of Git.
reports/tune_changes/*.json
reports/tune_changes/*.md
!reports/tune_changes/.gitkeep

# AeroTune local-only files
*.zip
sample_logs/*.BBL
sample_logs/*.bbl
sample_logs/*.BFL
sample_logs/*.bfl
sample_logs/*.TXT
sample_logs/*.txt
uploads/*
!uploads/.gitkeep
reports/*
!reports/.gitkeep
